#!/usr/bin/env bash
set -eo pipefail

tool_name="opencode" # Update this to match your tool name
install_type="$ASDF_INSTALL_TYPE"
version="$ASDF_INSTALL_VERSION"
install_path="$ASDF_INSTALL_PATH"
download_path="$ASDF_DOWNLOAD_PATH"

if [ "$install_type" != "version" ]; then
  echo "asdf-$tool_name supports data-type 'version' only (got: $install_type)"
  exit 1
fi

(
  mkdir -p "$install_path/bin"

  # Navigate to download folder where the download script saved the file
  cd "$download_path"

  echo "Installing $tool_name v$version..."

  # 1. Handle tar.gz files (Standard for Linux)
  # Check if a tar.gz exists before running tar to avoid error messages
  if ls ./*.tar.gz >/dev/null 2>&1; then
    find . -name "*.tar.gz" -maxdepth 1 -exec tar -zxf {} -C "$install_path/bin" \;
  fi

  # 2. Handle .zip files (Standard for macOS/Darwin)
  # -o: overwrite files without prompting
  # -j: junk paths (extract binaries directly into bin/ without internal folders)
  if ls ./*.zip >/dev/null 2>&1; then
    unzip -oq ./*.zip -d "$install_path/bin"
  fi

  # Ensure the extracted binaries are executable
  chmod +x "$install_path/bin"/* 2>/dev/null || true

  echo "$tool_name v$version installation was successful!"
) || {
  echo "Error: Installation failed."
  exit 1
}
